<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Para ti 💜</title>
    <style>
        /* Fondo celeste y configuración general */
        body {
            margin: 0;
            padding: 0;
            background-color: #a8d8ea; /* Color celeste suave */
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            overflow: hidden;
        }

        /* Texto Superior Izquierdo */
        .mensaje-superior {
            position: absolute;
            top: 30px;
            left: 30px;
            font-size: 1.4rem;
            color: #2c3e50;
            max-width: 400px;
            font-weight: 600;
            line-height: 1.5;
            animation: aparecerTexto 3s ease-in-out;
        }

        /* Texto Inferior Derecho (J.C.L.A) */
        .firma {
            position: absolute;
            bottom: 20px;
            right: 30px;
            font-size: 0.9rem;
            color: #2c3e50;
            font-weight: bold;
            letter-spacing: 3px;
            opacity: 0.8;
            animation: aparecerTexto 4s ease-in-out;
        }

        @keyframes aparecerTexto {
            0% { opacity: 0; transform: translateY(10px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* Contenedor de las flores */
        .jardin {
            display: flex;
            gap: 60px;
            align-items: flex-end;
            height: 300px;
            position: relative;
            top: 40px;
        }

        /* Animaciones base para crecer y florecer */
        @keyframes crecerTallo {
            0% { height: 0; }
            100% { height: 160px; }
        }
        @keyframes crecerTalloTulipan {
            0% { height: 0; }
            100% { height: 130px; }
        }
        @keyframes florecer {
            0% { transform: scale(0); opacity: 0; }
            80% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }
        @keyframes girarSuave {
            0% { transform: scale(1) rotate(0deg); }
            100% { transform: scale(1) rotate(360deg); }
        }

        /* --- ESTILOS DEL GIRASOL --- */
        .girasol-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
        }
        .tallo-girasol {
            width: 8px;
            height: 0px;
            background-color: #4caf50;
            border-radius: 4px;
            animation: crecerTallo 2s forwards;
            transform-origin: bottom;
        }
        .cabeza-girasol {
            position: relative;
            width: 80px;
            height: 80px;
            margin-bottom: -10px;
            z-index: 2;
            transform: scale(0);
            animation: florecer 1.5s 1.8s forwards; /* Florece después del tallo */
        }
        .centro-girasol {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 45px;
            height: 45px;
            background-color: #5d4037;
            border-radius: 50%;
            z-index: 3;
            box-shadow: inset 0 0 10px #3e2723;
        }
        .petalos-girasol {
            position: absolute;
            top: 0; left: 0; right: 0; bottom: 0;
            animation: girarSuave 25s linear infinite; /* Gira lentamente */
        }
        .petalo-g {
            position: absolute;
            top: -15px;
            left: 30px;
            width: 20px;
            height: 55px;
            background-color: #ffeb3b;
            border-radius: 50px 50px 0 0;
            transform-origin: 10px 55px;
            box-shadow: 0 0 5px rgba(0,0,0,0.1);
        }
        /* Posicionando los 8 pétalos */
        .petalo-g:nth-child(1) { transform: rotate(0deg); }
        .petalo-g:nth-child(2) { transform: rotate(45deg); }
        .petalo-g:nth-child(3) { transform: rotate(90deg); }
        .petalo-g:nth-child(4) { transform: rotate(135deg); }
        .petalo-g:nth-child(5) { transform: rotate(180deg); }
        .petalo-g:nth-child(6) { transform: rotate(225deg); }
        .petalo-g:nth-child(7) { transform: rotate(270deg); }
        .petalo-g:nth-child(8) { transform: rotate(315deg); }

        .hoja-girasol {
            position: absolute;
            bottom: 40px;
            right: -25px;
            width: 30px;
            height: 50px;
            background-color: #4caf50;
            border-radius: 0 50% 0 50%;
            transform: rotate(30deg) scale(0);
            transform-origin: bottom left;
            animation: florecer 1s 1.5s forwards;
        }

        /* --- ESTILOS DEL TULIPÁN --- */
        .tulipan-wrapper {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: flex-end;
        }
        .tallo-tulipan {
            width: 6px;
            height: 0px;
            background-color: #388e3c;
            border-radius: 3px;
            animation: crecerTalloTulipan 2s 1s forwards; /* Inicia un poco después del girasol */
            transform-origin: bottom;
        }
        .cabeza-tulipan {
            position: relative;
            width: 45px;
            height: 55px;
            background-color: #ff4081;
            border-radius: 40% 40% 10% 10%;
            margin-bottom: -5px;
            z-index: 2;
            transform: scale(0);
            animation: florecer 1.5s 2.5s forwards;
            box-shadow: inset -5px -5px 10px rgba(0,0,0,0.1);
        }
        /* Pétalos laterales del tulipán */
        .cabeza-tulipan::before, .cabeza-tulipan::after {
            content: '';
            position: absolute;
            bottom: 0;
            width: 25px;
            height: 60px;
            background-color: #f50057;
            border-radius: 40% 40% 10% 10%;
        }
        .cabeza-tulipan::before {
            left: -5px;
            transform: rotate(-15deg);
            transform-origin: bottom right;
        }
        .cabeza-tulipan::after {
            right: -5px;
            transform: rotate(15deg);
            transform-origin: bottom left;
        }
        
        .hoja-tulipan {
            position: absolute;
            bottom: 30px;
            left: -20px;
            width: 25px;
            height: 45px;
            background-color: #388e3c;
            border-radius: 50% 0 50% 0;
            transform: rotate(-30deg) scale(0);
            transform-origin: bottom right;
            animation: florecer 1s 2.2s forwards;
        }

    </style>
</head>
<body>

    <!-- Mensaje Superior -->
    <div class="mensaje-superior">
        Se que no es lo que esperabas, o no es mucho, pero es con cariño... lokita mia :3💜
    </div>

    <!-- El Jardín Animado -->
    <div class="jardin">
        
        <!-- Flor 1: Girasol -->
        <div class="girasol-wrapper">
            <div class="cabeza-girasol">
                <div class="petalos-girasol">
                    <div class="petalo-g"></div>
                    <div class="petalo-g"></div>
                    <div class="petalo-g"></div>
                    <div class="petalo-g"></div>
                    <div class="petalo-g"></div>
                    <div class="petalo-g"></div>
                    <div class="petalo-g"></div>
                    <div class="petalo-g"></div>
                </div>
                <div class="centro-girasol"></div>
            </div>
            <div style="position: relative;">
                <div class="tallo-girasol"></div>
                <div class="hoja-girasol"></div>
            </div>
        </div>

        <!-- Flor 2: Tulipán -->
        <div class="tulipan-wrapper">
            <div class="cabeza-tulipan"></div>
            <div style="position: relative;">
                <div class="tallo-tulipan"></div>
                <div class="hoja-tulipan"></div>
            </div>
        </div>

    </div>

    <!-- Firma Inferior -->
    <div class="firma">
        J.C.L.A
    </div>

</body>
</html>
